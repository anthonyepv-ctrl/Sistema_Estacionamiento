# BD compartida (Neon) — pide el valor real al equipo, NO lo subas a Git
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Puerto del servidor Express
PORT=3000

# Firma de los tokens de sesión (obligatorio en producción).
# Sin este valor el servidor genera un secreto aleatorio por proceso y las sesiones
# se invalidan al reiniciar. Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Vigencia de la sesión en horas (opcional, por defecto 8)
AUTH_TTL_HORAS=8

{
  "name": "sistema-estacionamiento",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Cochera",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npx prisma migrate deploy && node server.js",
    "dev": "node --watch server.js",
    "setup:skills": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-skills.ps1",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "node scripts/run-all-tests.js",
    "test:culqi": "node tests/test-pasarela-culqi-unit.js",
    "test:upao22": "node tests/test-upao22-anulacion.js",
    "test:upao8": "node tests/test-upao8-garita.js",
    "test:upao23": "node tests/test-upao23-historial.js",
    "test:ataque": "node tests/test-ataque-bot.js",
    "test:e2e": "node tests/e2e-ingreso.js",
    "test:graficos": "node tests/e2e-graficos-estadisticos.js",
    "test:disponibilidad": "node tests/e2e-disponibilidad.js",
    "test:integridad": "node tests/test-integridad-cobro.js",
    "test:concurrencia": "node tests/test-concurrencia-aforo.js",
    "test:seguridad": "node tests/test-seguridad-api.js",
    "test:regresion": "node tests/test-no-regresion.js",
    "test:reservas": "node tests/test-reservas-sprint3.js",
    "test:auditoria": "node tests/test-auditoria-batalla.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}

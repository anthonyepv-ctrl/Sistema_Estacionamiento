generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  RECEPCIONISTA
  DUENO     @map("DUEÑO")
  CONDUCTOR

  @@map("rol_usuario")
}

enum EstadoReserva {
  VIGENTE
  UTILIZADA
  ANULADA
  VENCIDA

  @@map("estado_reserva")
}

enum EstadoPagoReserva {
  PAGADO
  REEMBOLSADO

  @@map("estado_pago_reserva")
}

model Usuario {
  id         Int     @id @default(autoincrement()) @map("id_usuario")
  usuario    String  @unique @db.VarChar(50)
  nombre     String  @db.VarChar(100)
  contrasena String  @db.VarChar(255)
  rol        Rol     @default(RECEPCIONISTA)
  dni        String? @unique @db.VarChar(8)
  celular    String? @db.VarChar(9)

  estadias  Estadia[]
  vehiculos VehiculoConductor[]
  reservas  Reserva[]

  @@map("usuario")
}

model TipoVehiculo {
  id     Int    @id @default(autoincrement()) @map("id_tipo_vehiculo")
  nombre String @unique @db.VarChar(50)

  tarifas   Tarifa[]
  estadias  Estadia[]
  vehiculos VehiculoConductor[]
  reservas  Reserva[]

  @@map("tipo_vehiculo")
}

model Tarifa {
  id             Int     @id @default(autoincrement()) @map("id_tarifa")
  idTipoVehiculo Int     @map("id_tipo_vehiculo")
  precioHora     Decimal @db.Decimal(10, 2) @map("precio_hora")
  precioFraccion Decimal @db.Decimal(10, 2) @map("precio_fraccion")
  estado         Boolean @default(true)

  tipoVehiculo TipoVehiculo @relation(fields: [idTipoVehiculo], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estadias     Estadia[]

  @@map("tarifa")
}

model Estadia {
  id             Int       @id @default(autoincrement()) @map("id_estadia")
  placa          String    @db.VarChar(10)
  idTipoVehiculo Int       @map("id_tipo_vehiculo")
  idTarifa       Int       @map("id_tarifa")
  idUsuario      Int       @map("id_usuario")
  idPago         Int?      @unique @map("id_pago")
  idReserva      Int?      @unique @map("id_reserva")
  horaIngreso    DateTime  @default(now()) @map("hora_ingreso")
  horaSalida     DateTime? @map("hora_salida")
  nota           String?   @db.VarChar(250) @map("nota")

  tipoVehiculo TipoVehiculo @relation(fields: [idTipoVehiculo], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tarifa       Tarifa       @relation(fields: [idTarifa], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario      Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pago         Pago?        @relation(fields: [idPago], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reserva      Reserva?     @relation(fields: [idReserva], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([placa])
  @@map("estadia")
}

model Pago {
  id             Int      @id @default(autoincrement()) @map("id_pago")
  idMetodoPago   Int      @map("id_metodo_pago")
  monto          Decimal  @db.Decimal(10, 2)
  tiempoHoras    Decimal  @default(0) @db.Decimal(6, 2) @map("tiempo_horas")
  tiempoFraccion Decimal  @default(0) @db.Decimal(6, 2) @map("tiempo_fraccion")
  fechaHora      DateTime @default(now()) @map("fecha_hora")

  metodoPago MetodoPago @relation(fields: [idMetodoPago], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estadia    Estadia?

  @@map("pago")
}

model MetodoPago {
  id     Int    @id @default(autoincrement()) @map("id_metodo_pago")
  nombre String @unique @db.VarChar(50)

  pagos Pago[]

  @@map("metodo_pago")
}

model VehiculoConductor {
  id             Int      @id @default(autoincrement()) @map("id_vehiculo")
  idUsuario      Int      @map("id_usuario")
  placa          String   @db.VarChar(10)
  idTipoVehiculo Int      @map("id_tipo_vehiculo")
  creadoEn       DateTime @default(now()) @map("creado_en")

  usuario      Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tipoVehiculo TipoVehiculo @relation(fields: [idTipoVehiculo], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservas     Reserva[]

  @@unique([idUsuario, placa])
  @@map("vehiculo_conductor")
}

model Reserva {
  id                    Int               @id @default(autoincrement()) @map("id_reserva")
  codigo                String            @unique @db.VarChar(16)
  idUsuario             Int               @map("id_usuario")
  idVehiculo            Int               @map("id_vehiculo")
  idTipoVehiculo        Int               @map("id_tipo_vehiculo")
  fechaReserva          DateTime          @default(now()) @map("fecha_reserva")
  fechaLimite           DateTime          @map("fecha_limite")
  estado                EstadoReserva     @default(VIGENTE)
  montoAdelanto         Decimal           @db.Decimal(10, 2) @map("monto_adelanto")
  stripePaymentIntentId String?           @db.VarChar(100) @map("stripe_payment_intent_id")
  estadoPago            EstadoPagoReserva @default(PAGADO) @map("estado_pago")
  fechaAnulacion        DateTime?         @map("fecha_anulacion")
  creadoEn              DateTime          @default(now()) @map("creado_en")

  usuario      Usuario           @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehiculo     VehiculoConductor @relation(fields: [idVehiculo], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tipoVehiculo TipoVehiculo      @relation(fields: [idTipoVehiculo], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estadia      Estadia?

  @@index([estado, idTipoVehiculo])
  @@index([idUsuario, estado])
  @@map("reserva")
}
